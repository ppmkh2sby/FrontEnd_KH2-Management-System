# PostgreSQL database created inside Docker on this VM. Do not reuse these
# placeholders in production. Generate a password with: openssl rand -base64 32
POSTGRES_DB=kh2_management_system
POSTGRES_USER=kh2_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# The public URL users open in their browser. Keep APP_HOST without http(s).
# For first HTTP-only testing:
# APP_ORIGIN=http://PUBLIC_IP_VM
# APP_HOST=PUBLIC_IP_VM
# After HTTPS and a domain are configured:
# APP_ORIGIN=https://app.example.com
# APP_HOST=app.example.com
APP_ORIGIN=http://PUBLIC_IP_VM
APP_HOST=PUBLIC_IP_VM

# Canonical public hostname used by Caddy for automatic TLS certificates.
APP_DOMAIN=app.example.com

# Generate with: openssl rand -base64 48
# Must be at least 32 characters and must never be committed to Git.
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_JWT_SECRET

# Must be different from JWT_SECRET_KEY. The backend uses this key to call the
# private Face Recognition service.
# Generate with: openssl rand -base64 48
FACE_SERVICE_API_KEY=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_FACE_SERVICE_KEY

# Keep false until HTTPS is truly terminated by Azure/Application Gateway or a
# reverse proxy. Set true only after APP_ORIGIN uses https.
HTTPS_ENABLED=false
